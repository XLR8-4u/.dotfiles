{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "kitty",
    "source": "/home/mika/cat.png",
    "height": 12,
    "width": 24,
    "padding": {
      "top": 1,
      "left": 0,
      "right": 2
    }
  },
  "modules": [
    {
      "type": "title",
      "color": {
        "user": "cyan",
        "host": "red"
      }
    },
    "separator",
    "os",
    "host",
    "uptime",
    "shell",
    "wm",
    "cpu",
    "gpu",
    "memory",
    "localip",
    "break",
    "colors",
    "break"
  ]
}
